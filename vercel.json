{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://aviothic-ar-y48e.onrender.com/api/$1"
        },
        {
            "source": "/(extensions_.*|vendors-.*|modes_.*|ort/.*|customizations/.*|dicom-microscopy-viewer/.*|.*\\.wasm|.*\\.woff2|app-config\\.js|init-service-worker\\.js|app\\.js)",
            "destination": "/viewer/$1"
        },
        {
            "source": "/viewer/(.*)",
            "destination": "/viewer/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Security-Policy",
                    "value": "frame-ancestors 'self' https://*.vercel.app http://localhost:*"
                }
            ]
        }
    ]
}
